# ── Supabase ─────────────────────────────────────────────────────────
# Local: los valores los imprime `pnpm exec supabase start` (o `supabase status`).
# Producción: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor. Nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dominio del email interno de las cuentas (usuario@dominio). Opcional.
# NO lo cambies cuando ya haya cuentas creadas: dejarían de poder ingresar.
# AUTH_USERNAME_DOMAIN=usuarios.hogar.invalid

# ── DeepSeek (API compatible con OpenAI) ─────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Verificá el nombre con: curl https://api.deepseek.com/models -H "Authorization: Bearer $DEEPSEEK_API_KEY"
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Categorización ───────────────────────────────────────────────────
AI_TIMEOUT_MS=5000
AI_REVIEW_THRESHOLD=0.6
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=300
